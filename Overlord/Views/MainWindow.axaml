<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Overlord.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="Overlord.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Overlord"
        Width="1100" Height="700" MinWidth="760" MinHeight="480"
        Background="{DynamicResource SurfaceBrush}">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <!-- Skyve-style shell: navigation rail | page. The details pane arrives with the Mods page. -->
    <Grid ColumnDefinitions="200,*">
        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceSunkenBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="OVERLORD"
                           Margin="20,24,20,20"
                           FontSize="16" FontWeight="Bold" LetterSpacing="2"
                           Foreground="{DynamicResource AccentBrush}" />
                <ListBox ItemsSource="{Binding NavItems}"
                         SelectedItem="{Binding SelectedNav}"
                         Background="Transparent"
                         Margin="8,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:NavItem">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="{Binding Glyph}" Width="16" TextAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding Title}"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding SelectedNav.Page}" />
    </Grid>
</Window>
