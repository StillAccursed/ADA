<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Overlord.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="Overlord.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Overlord"
        Width="1100" Height="700" MinWidth="760" MinHeight="480"
        Background="{DynamicResource SurfaceBrush}">

    <!-- Skyve-style shell: navigation rail | page. The details pane arrives with the Mods page. -->
    <Grid ColumnDefinitions="200,*">
        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceSunkenBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="OVERLORD"
                           Margin="20,24,20,20"
                           FontSize="16" FontWeight="Bold" LetterSpacing="2"
                           Foreground="{DynamicResource AccentBrush}" />
                <!-- Footer: check installed mods for updates; the catalogue's last refresh underneath. -->
                <StackPanel DockPanel.Dock="Bottom" Margin="16,8,16,16" Spacing="6">
                    <Border Height="1" Margin="-8,0,-8,8" Background="{DynamicResource BorderSubtleBrush}" />
                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Content="Check for Updates"
                            Click="OnCheckForUpdates" />
                    <TextBlock Text="{Binding Catalog.SummaryText}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <ListBox ItemsSource="{Binding NavItems}"
                         SelectedItem="{Binding SelectedNav}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Background="Transparent"
                         Margin="8,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:NavItem">
                            <Grid ColumnDefinitions="16,*,Auto" ColumnSpacing="12">
                                <TextBlock Text="{Binding Glyph}" TextAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding Title}"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Grid.Column="2" Text="↑" FontWeight="Bold"
                                           IsVisible="{Binding HasUpdates}"
                                           ToolTip.Tip="Mod updates available"
                                           Foreground="{DynamicResource AccentBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding SelectedNav.Page}" />
    </Grid>
</Window>
