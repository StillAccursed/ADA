<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Overlord.ViewModels"
             xmlns:games="using:Overlord.Core.Games"
             x:Class="Overlord.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
    <DockPanel Margin="32,28">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
            <TextBlock Text="Dashboard" FontSize="24" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <Button Grid.Column="1" Content="Rescan" Command="{Binding ScanCommand}" />
        </Grid>
        <TextBlock DockPanel.Dock="Top" Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,0,0,20"
                   Foreground="{DynamicResource TextSecondaryBrush}" />

        <!-- Mod catalogue: checked on launch and by the button. -->
        <Border DockPanel.Dock="Top" Margin="0,0,0,20" Padding="20,16" CornerRadius="8" BorderThickness="1"
                Background="{DynamicResource SurfaceRaisedBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                <TextBlock Text="Mod catalogue" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <Button Grid.Column="1" Grid.RowSpan="2" VerticalAlignment="Center"
                        Content="Check for Updates"
                        Command="{Binding Catalog.CheckForUpdatesCommand}" />
                <TextBlock Grid.Row="1" Text="{Binding Catalog.SummaryText}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Catalog.ErrorText}" Margin="0,8,0,0"
                           TextWrapping="Wrap" IsVisible="{Binding Catalog.ErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Foreground="{DynamicResource WarningBrush}" />
            </Grid>
        </Border>

        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Installs}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="12" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="games:GameInstall">
                        <Border Background="{DynamicResource SurfaceRaisedBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="20,16">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                                <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding Host}"
                                           Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding BuildText}" Margin="0,6,0,0"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Location}" Margin="0,4,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <SelectableTextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding GamePath}" Margin="0,4,0,0"
                                                     FontFamily="monospace" FontSize="12"
                                                     Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
