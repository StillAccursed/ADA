<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Overlord.ViewModels"
             x:Class="Overlord.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
    <DockPanel Margin="32,28">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
            <TextBlock Text="Dashboard" FontSize="24" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <Button Grid.Column="1" Content="Rescan" Command="{Binding ScanCommand}" />
        </Grid>
        <TextBlock DockPanel.Dock="Top" Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,0,0,20"
                   Foreground="{DynamicResource TextSecondaryBrush}" />

        <!-- Satisfactory is running: mods can't change until it closes. -->
        <Border DockPanel.Dock="Top" Margin="0,0,0,20" Padding="20,14" CornerRadius="8" BorderThickness="1"
                IsVisible="{Binding IsGameRunning}"
                Background="{DynamicResource SurfaceRaisedBrush}"
                BorderBrush="{DynamicResource WarningBrush}">
            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ShowCloseOffer}">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Satisfactory is running" FontWeight="SemiBold"
                                   Foreground="{DynamicResource WarningBrush}" />
                        <TextBlock Text="Close it before installing, updating or repairing mods. The game locks mod files while it runs."
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"
                            Content="Close Satisfactory" Command="{Binding CloseGameCommand}" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding ConfirmingClose}">
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="Close Satisfactory now? Anything since your last save or autosave will be lost." />
                    <Button Grid.Column="1" Margin="16,0,8,0" Content="Close now" Command="{Binding ConfirmCloseGameCommand}" />
                    <Button Grid.Column="2" Content="Cancel" Command="{Binding CancelCloseGameCommand}" />
                </Grid>

                <TextBlock Text="Closing Satisfactory…" IsVisible="{Binding IsClosingGame}"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Text="{Binding CloseError}" TextWrapping="Wrap"
                           IsVisible="{Binding CloseError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Foreground="{DynamicResource WarningBrush}" />
            </StackPanel>
        </Border>

        <!-- Mod catalogue: refreshed on launch and periodically; shows when it last was. -->
        <Border DockPanel.Dock="Top" Margin="0,0,0,20" Padding="20,16" CornerRadius="8" BorderThickness="1"
                Background="{DynamicResource SurfaceRaisedBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}">
            <Grid RowDefinitions="Auto,Auto,Auto">
                <TextBlock Text="Mod catalogue" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Grid.Row="1" Text="{Binding Catalog.SummaryText}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Grid.Row="2" Text="{Binding Catalog.ErrorText}" Margin="0,8,0,0"
                           TextWrapping="Wrap" IsVisible="{Binding Catalog.ErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Foreground="{DynamicResource WarningBrush}" />
            </Grid>
        </Border>

        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Installs}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="12" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:GameInstallViewModel">
                        <Border Background="{DynamicResource SurfaceRaisedBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="20,16">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                                <TextBlock Text="{Binding Install.DisplayName}" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding Install.Host}"
                                           Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Grid.Row="1" Text="{Binding Install.BuildText}" Margin="0,6,0,0"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Margin="12,6,0,0"
                                           Text="{Binding ProfileName, StringFormat='Profile: {0}'}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Install.Location}" Margin="0,4,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <SelectableTextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding Install.GamePath}" Margin="0,4,0,0"
                                                     FontFamily="monospace" FontSize="12"
                                                     Foreground="{DynamicResource TextSecondaryBrush}" />

                                <!-- Mods Overlord manages in this game: from the launch check. -->
                                <Border Grid.Row="4" Grid.ColumnSpan="2" Height="1" Margin="0,14,0,12"
                                        Background="{DynamicResource BorderSubtleBrush}" />
                                <TextBlock Grid.Row="5" Text="{Binding ModsSummary}" TextWrapping="Wrap" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <Button Grid.Row="5" Grid.Column="1" Content="Repair" Margin="12,0,0,0"
                                        Command="{Binding RepairCommand}" IsVisible="{Binding HasRepairs}" />
                                <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Spacing="4">
                                    <TextBlock Text="{Binding ProgressText}" Margin="0,6,0,0" TextWrapping="Wrap"
                                               IsVisible="{Binding ProgressText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding Notice}" Margin="0,6,0,0" TextWrapping="Wrap"
                                               IsVisible="{Binding Notice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                               Foreground="{DynamicResource WarningBrush}" />
                                </StackPanel>

                                <!-- Mods another manager installed: import into the current profile or a new one. -->
                                <Border Grid.Row="7" Grid.ColumnSpan="2" Margin="0,14,0,0" Padding="16,12" CornerRadius="8"
                                        BorderThickness="1" IsVisible="{Binding HasFoundMods}"
                                        Background="{DynamicResource SurfaceSunkenBrush}"
                                        BorderBrush="{DynamicResource AccentBrush}">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="{Binding FoundTitle}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding FoundNames}" TextWrapping="Wrap" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock TextWrapping="Wrap" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Text="Overlord never edits Satisfactory Mod Manager's own files. SMM keeps its own record of what it installed (its installations file and profile lock files), so after Overlord adds or updates mods here, SMM's record won't match this game's Mods folder." />

                                        <StackPanel Spacing="8" IsVisible="{Binding ShowFoundChoice}">
                                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Text="Overlord can look after them from now on. Their files stay where they are." />
                                            <WrapPanel>
                                                <Button Margin="0,0,8,8" Classes="accent" Content="{Binding ImportToCurrentText}"
                                                        Command="{Binding ImportToCurrentCommand}" />
                                                <Button Margin="0,0,8,8" Content="Add to a new profile…" Command="{Binding ChooseNewProfileCommand}" />
                                            </WrapPanel>
                                        </StackPanel>

                                        <StackPanel Spacing="8" IsVisible="{Binding ShowNewProfile}">
                                            <TextBlock Text="Profile name" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBox Text="{Binding NewProfileName}" MaxLength="100" />
                                            <TextBlock Text="{Binding NewProfileProblem}" TextWrapping="Wrap"
                                                       IsVisible="{Binding NewProfileProblem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                       Foreground="{DynamicResource WarningBrush}" />
                                            <CheckBox IsChecked="{Binding SwitchToNewProfile}"
                                                      Content="Switch this game to the new profile now" />
                                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Text="If you don't switch, the profile is saved for later and the mods stay in the Mods folder as they are." />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button Classes="accent" Content="Create profile" Command="{Binding CreateNewProfileCommand}" />
                                                <Button Content="Back" Command="{Binding BackToFoundChoiceCommand}" />
                                            </StackPanel>
                                        </StackPanel>

                                    </StackPanel>
                                </Border>

                                <!-- What installed mods are missing (e.g. SML after an import), fixed through the resolver. -->
                                <Border Grid.Row="8" Grid.ColumnSpan="2" Margin="0,14,0,0" Padding="16,12" CornerRadius="8"
                                        BorderThickness="1" IsVisible="{Binding HasFix}"
                                        Background="{DynamicResource SurfaceSunkenBrush}"
                                        BorderBrush="{DynamicResource WarningBrush}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Some mods are missing what they need to load" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <ItemsControl ItemsSource="{Binding FixLines}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,1"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Classes="accent" Content="Fix" Command="{Binding FixCommand}" />
                                            <Button Content="Not now" Command="{Binding DismissFixCommand}" />
                                        </StackPanel>
                                        <TextBlock Text="Close Satisfactory first." IsVisible="{Binding IsGameRunning}"
                                                   Foreground="{DynamicResource WarningBrush}" />
                                    </StackPanel>
                                </Border>
                                <SelectableTextBlock Grid.Row="8" Grid.ColumnSpan="2" Margin="0,14,0,0" TextWrapping="Wrap"
                                                     Text="{Binding FixProblem}" IsVisible="{Binding HasFixProblem}"
                                                     Foreground="{DynamicResource WarningBrush}" />

                                <!-- Newer versions exist; they're reviewed and installed from "Check for Updates". -->
                                <TextBlock Grid.Row="9" Grid.ColumnSpan="2" Margin="0,14,0,0" TextWrapping="Wrap"
                                           IsVisible="{Binding HasUpdates}" Foreground="{DynamicResource AccentBrush}"
                                           Text="{Binding UpdatesTitle, StringFormat='{}{0}. Use Check for Updates to review them.'}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
