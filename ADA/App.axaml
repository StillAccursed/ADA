<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ADA.ViewModels"
             xmlns:views="using:ADA.Views"
             x:Class="ADA.App"
             RequestedThemeVariant="Default">
             <!-- "Default" follows the OS; Appearance.Apply replaces it with the saved theme at startup. -->

    <!-- Each page's view, by view model. Compiled, so nothing is looked up by reflection. -->
    <Application.DataTemplates>
        <DataTemplate DataType="vm:DashboardViewModel">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="vm:ModsViewModel">
            <views:ModsView />
        </DataTemplate>
        <DataTemplate DataType="vm:ServersViewModel">
            <views:ServersView />
        </DataTemplate>
        <DataTemplate DataType="vm:SavesViewModel">
            <views:SavesView />
        </DataTemplate>
        <DataTemplate DataType="vm:BackupsViewModel">
            <views:BackupsView />
        </DataTemplate>
        <DataTemplate DataType="vm:SettingsViewModel">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="vm:PlaceholderViewModel">
            <views:PlaceholderView />
        </DataTemplate>
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <!-- Replaced at runtime by InterfaceScale.Apply; every window's root binds to it. -->
            <ScaleTransform x:Key="InterfaceScaleTransform" ScaleX="1" ScaleY="1" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://ADA/Themes/Tokens.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <!-- Popups (dropdowns, flyouts, tooltips) open in their own top-level, outside each window's
             interface-scale transform; this makes them take on their target's scale. -->
        <Style Selector="Popup">
            <Setter Property="InheritsTransform" Value="True" />
        </Style>
        <!-- The Show button inside every password box: Show while hidden, Hide while the text shows. -->
        <Style Selector="ToggleButton.revealSecret">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="ToggleButton.revealSecret:checked">
            <Setter Property="Content" Value="Hide" />
        </Style>
    </Application.Styles>
</Application>
