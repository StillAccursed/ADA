<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ADA.ViewModels"
             xmlns:views="using:ADA.Views"
             xmlns:profiles="using:ADA.Core.Profiles"
             x:Class="ADA.Views.DashboardView" x:DataType="vm:DashboardViewModel">
    <UserControl.Styles>
        <Style Selector="Border.dashboard-card">
            <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style Selector="TextBlock.card-title">
            <Setter Property="FontWeight" Value="SemiBold" /><Setter Property="FontSize" Value="15" />
            <Setter Property="LetterSpacing" Value="0.5" /><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="TextBlock.secondary">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" /><Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.value">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /><Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Path.card-icon">
            <Setter Property="Width" Value="16" /><Setter Property="Height" Value="16" />
            <Setter Property="Stretch" Value="Uniform" /><Setter Property="StrokeThickness" Value="1.4" />
            <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
    </UserControl.Styles>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,28" Spacing="16">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Dashboard" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <Button Grid.Column="1" Content="Rescan" Command="{Binding ScanCommand}" />
            </Grid>
        <!-- Satisfactory is running: mods can't change until it closes. -->
        <Border Margin="0,0,0,20" Padding="20,14" CornerRadius="8" BorderThickness="1"
                IsVisible="{Binding IsGameRunning}"
                Background="{DynamicResource SurfaceRaisedBrush}"
                BorderBrush="{DynamicResource WarningBrush}">
            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ShowCloseOffer}">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Satisfactory is running" FontWeight="SemiBold"
                                   Foreground="{DynamicResource WarningBrush}" />
                        <TextBlock Text="Close it before installing, updating or repairing mods. The game locks mod files while it runs."
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"
                            Content="Close Satisfactory" Command="{Binding CloseGameCommand}" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding ConfirmingClose}">
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="Close Satisfactory now? Anything since your last save or autosave will be lost." />
                    <Button Grid.Column="1" Margin="16,0,8,0" Content="Close now" Command="{Binding ConfirmCloseGameCommand}" />
                    <Button Grid.Column="2" Content="Cancel" Command="{Binding CancelCloseGameCommand}" />
                </Grid>

                <TextBlock Text="Closing Satisfactory…" IsVisible="{Binding IsClosingGame}"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Text="{Binding CloseError}" TextWrapping="Wrap"
                           IsVisible="{Binding CloseError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Foreground="{DynamicResource WarningBrush}" />
            </StackPanel>
        </Border>


            <Grid x:Name="CardGrid" ColumnDefinitions="*,1.18*,0.95*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="14">
                <StackPanel x:Name="LeftCards" Spacing="14">
                    <!-- Shown by the code-behind only while the selected installation has something to act on. -->
                    <Border x:Name="AttentionCard" Classes="dashboard-card" IsVisible="False" BorderBrush="{DynamicResource WarningBrush}"><StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto"><TextBlock Classes="card-title" Text="Needs Attention" /><Path Grid.Column="1" Classes="card-icon" Data="M8,1 L15,14 L1,14 Z M8,6 L8,10 M8,12 L8,12.5" /></Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="{Binding ServerProblem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="{Binding ServerProblem}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource WarningBrush}" />
                            <Button Grid.Column="1" Content="Retry" VerticalAlignment="Top" Command="{Binding RetryServerCommand}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="{Binding IsOutOfSync}">
                            <TextBlock Text="{Binding SyncText}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource WarningBrush}" />
                            <Button Grid.Column="1" Content="{Binding SyncActionText}" VerticalAlignment="Top" Command="{Binding UpdateSyncTargetCommand}" />
                        </Grid>
                        <TextBlock Classes="secondary" FontSize="12" Text="{Binding SelectedInstall.Install.DisplayName}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="{Binding SelectedInstall.Notice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="{Binding SelectedInstall.Notice}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource WarningBrush}" />
                            <Button Grid.Column="1" Content="Dismiss" VerticalAlignment="Top" Command="{Binding SelectedInstall.DismissNoticeCommand}" />
                        </Grid>
                        <TextBlock Classes="secondary" Text="{Binding SelectedInstall.ProgressText}" IsVisible="{Binding SelectedInstall.ProgressText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <views:InstallationDetailsView DataContext="{Binding SelectedInstall}" />
                    </StackPanel></Border>
                    <Border Classes="dashboard-card"><StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto"><TextBlock Classes="card-title" Text="Profiles" /><Path Grid.Column="1" Classes="card-icon" Data="M1,5 L8,1 L15,5 L8,9 Z M1,8 L8,12 L15,8 M1,11 L8,15 L15,11" /></Grid>
                        <TextBlock Classes="secondary" FontSize="12" Text="Active profile" />
                        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                                  IsEnabled="{Binding CanChooseProfile}" AutomationProperties.Name="Active profile">
                            <ComboBox.ItemTemplate><DataTemplate x:DataType="profiles:ModProfile"><TextBlock Text="{Binding Name}" TextWrapping="Wrap" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Classes="secondary" Text="{Binding ProfilesText}" /><TextBlock Classes="secondary" Text="{Binding ProfileModsText}" />
                        <Button Content="New profile…" Command="{Binding NewProfileCommand}" IsEnabled="{Binding CanChooseProfile}"
                                ToolTip.Tip="Save the installed mods as a new profile, e.g. for a new playthrough" />
                        <TextBlock Classes="secondary" Text="Close Satisfactory and wait for current operations to finish before switching." IsVisible="{Binding !CanChooseProfile}" FontSize="12" />
                        <TextBlock Classes="value" Text="{Binding ProfileNotice}" IsVisible="{Binding ProfileNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel></Border>
                    <Border Classes="dashboard-card"><StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto"><TextBlock Classes="card-title" Text="Disk Status" /><Path Grid.Column="1" Classes="card-icon" Data="M2,2 L14,2 L14,14 L2,14 Z M2,10 L14,10 M10,12 L12,12" /></Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><TextBlock Classes="secondary" Text="{Binding DiskModsLabel}" /><TextBlock Grid.Column="1" Classes="value" Text="{Binding Disk.ModsSize}" /></Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" ToolTip.Tip="Downloaded archives shared across installations"><TextBlock Classes="secondary" Text="Archive size" /><TextBlock Grid.Column="1" Classes="value" Text="{Binding Disk.ArchiveSize}" /></Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><TextBlock Classes="secondary" Text="Backups size" /><TextBlock Grid.Column="1" Classes="secondary" Text="Coming soon" /></Grid>
                        <TextBlock Classes="secondary" FontSize="12" Text="User backups of Saves, Settings and Mods." />
                        <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><TextBlock Classes="value" Text="Mods + archives" /><TextBlock Grid.Column="1" Classes="value" FontWeight="SemiBold" Text="{Binding Disk.TotalSize}" /></Grid>
                        <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" />
                        <TextBlock Classes="secondary" FontSize="12" Text="{Binding DiskVolumeLabel}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><TextBlock Classes="value" Text="Available" /><TextBlock Grid.Column="1" Classes="value" FontWeight="SemiBold" Text="{Binding Disk.AvailableSpace}" /></Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><TextBlock Classes="secondary" Text="Total capacity" /><TextBlock Grid.Column="1" Classes="secondary" Text="{Binding Disk.TotalCapacity}" /></Grid>
                        <TextBlock Classes="secondary" Text="{Binding Disk.ArchiveAvailableSpace, StringFormat='Archive drive: {0} available'}" IsVisible="{Binding Disk.HasSeparateArchiveVolume}" />
                        <TextBlock Text="{Binding Disk.Problem}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}" IsVisible="{Binding Disk.Problem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel></Border>
                </StackPanel>
                <Border x:Name="LatestCard" Grid.Column="1" Classes="dashboard-card" VerticalAlignment="Top"><StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto"><TextBlock Classes="card-title" Text="Latest Updated Mods" TextWrapping="Wrap" /><Path Grid.Column="1" Classes="card-icon" Data="M1,4 L8,1 L15,4 L15,12 L8,15 L1,12 Z M1,4 L8,7 L15,4 M8,7 L8,15" /></Grid>
                    <TextBlock Classes="secondary" Text="{Binding RecentModsState}" IsVisible="{Binding RecentModsState, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <ItemsControl ItemsSource="{Binding RecentMods}"><ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DashboardModViewModel">
                            <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderSubtleBrush}" Padding="0,0,0,12" Margin="0,0,0,12"><StackPanel Spacing="5">
                                <TextBlock Classes="value" FontWeight="SemiBold" Text="{Binding Name}" />
                                <TextBlock Classes="secondary" FontSize="12" Text="{Binding Version}" />
                                <TextBlock Classes="secondary" FontSize="12" Text="{Binding Released}" />
                                <TextBlock Classes="secondary" Text="{Binding Description}" />
                            </StackPanel></Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate></ItemsControl>
                </StackPanel></Border>
                <StackPanel x:Name="RightCards" Grid.Column="2" Spacing="14">
                    <Border Classes="dashboard-card"><StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto"><TextBlock Classes="card-title" Text="ADA Status" /><Path Grid.Column="1" Classes="card-icon" Data="M3,11 L4,9 L4,5 C4,0 12,0 12,5 L12,9 L13,11 Z M6,14 L10,14" /></Grid>
                        <TextBlock Classes="secondary" FontSize="12" Text="Last catalogue update" />
                        <TextBlock Classes="value" Text="{Binding LastCatalogUpdateText}" />
                        <TextBlock Classes="secondary" Text="{Binding Catalog.SummaryText}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><TextBlock Classes="secondary" Text="Satisfactory" /><TextBlock Grid.Column="1" Classes="value" Text="{Binding GameStateText}" /></Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="{Binding ServerStateText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Classes="secondary" Text="Server" /><TextBlock Grid.Column="1" Classes="value" Text="{Binding ServerStateText}" /></Grid>
                        <StackPanel Spacing="2" IsVisible="{Binding SyncText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Classes="secondary" Text="Multiplayer" />
                            <TextBlock Classes="value" Text="{Binding SyncText}" TextWrapping="Wrap" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,4,0,0"
                                  IsVisible="{Binding ConfigsText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Classes="secondary" Text="{Binding ConfigsText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Push configs…" Command="{Binding PushConfigsCommand}" VerticalAlignment="Top" />
                            </Grid>
                        </StackPanel>
                        <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" />
                        <TextBlock Classes="value" Text="Notifications" FontWeight="SemiBold" /><TextBlock Classes="secondary" Text="{Binding Notifications}" />
                    </StackPanel></Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
