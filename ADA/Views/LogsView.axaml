<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ADA.ViewModels"
             x:Class="ADA.Views.LogsView"
             x:DataType="vm:LogsViewModel">
    <UserControl.Styles>
        <Style Selector="TextBlock.detail">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <Style Selector="TextBlock.level">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <Style Selector="TextBlock.level.warning">
            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
        </Style>
        <Style Selector="TextBlock.level.error">
            <Setter Property="Foreground" Value="{DynamicResource FailureBrush}" />
        </Style>
        <Style Selector="ListBox.log ListBoxItem">
            <Setter Property="Padding" Value="6,3" />
        </Style>
    </UserControl.Styles>

    <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,8">
            <ComboBox MinWidth="200" ItemsSource="{Binding Days}" SelectedItem="{Binding SelectedDay}" PlaceholderText="No logs" />
            <ComboBox Grid.Column="1" MinWidth="170" ItemsSource="{Binding Levels}" SelectedItem="{Binding SelectedLevel}" />
            <TextBox Grid.Column="2" PlaceholderText="Search messages and stack traces" Text="{Binding SearchText}" />
            <Button Grid.Column="3" Content="Refresh" Command="{Binding RefreshCommand}" />
            <Button Grid.Column="4" Content="Copy" Command="{Binding CopyCommand}"
                    ToolTip.Tip="Copies the shown messages in full, for a bug report" />
            <Button Grid.Column="5" Content="Show folder" Click="OnShowFolder" ToolTip.Tip="{Binding FolderPath}" />
        </Grid>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="2,0,0,4">
            <TextBlock Classes="detail" Text="{Binding CountText}" />
            <TextBlock Classes="detail" Text="{Binding Status}" Foreground="{DynamicResource AccentBrush}"
                       IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" Classes="detail" Text="{Binding TruncatedText}" Margin="2,0,0,4"
                   IsVisible="{Binding TruncatedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Foreground="{DynamicResource WarningBrush}" />
        <TextBlock DockPanel.Dock="Top" Text="{Binding Notice}" TextWrapping="Wrap" Margin="2,0,0,8"
                   IsVisible="{Binding Notice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Foreground="{DynamicResource WarningBrush}" />

        <!-- The selected message in full; the list keeps the rest of the height. -->
        <Border DockPanel.Dock="Bottom" IsVisible="{Binding HasSelection}" Margin="0,8,0,0" Padding="10,8" CornerRadius="6"
                BorderThickness="1" Background="{DynamicResource SurfaceSunkenBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}">
            <ScrollViewer MaxHeight="220">
                <SelectableTextBlock Text="{Binding Selected.FullText, FallbackValue=''}" TextWrapping="Wrap" FontSize="12"
                                     FontFamily="Menlo, Consolas, DejaVu Sans Mono, monospace"
                                     Foreground="{DynamicResource TextPrimaryBrush}" />
            </ScrollViewer>
        </Border>

        <Panel>
            <TextBlock Text="{Binding EmptyText}" IsVisible="{Binding !ShowsList}" TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" FontSize="15"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <ListBox x:Name="Lines" Classes="log" IsVisible="{Binding ShowsList}" Background="Transparent"
                     ItemsSource="{Binding Shown}" SelectedItem="{Binding Selected}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:LogLineViewModel">
                        <Grid ColumnDefinitions="80,64,*" ColumnSpacing="8">
                            <TextBlock Classes="detail" Text="{Binding TimeText}" TextWrapping="NoWrap" />
                            <TextBlock Grid.Column="1" Classes="level" Classes.warning="{Binding IsWarning}"
                                       Classes.error="{Binding IsError}" Text="{Binding LevelText}" />
                            <TextBlock Grid.Column="2" Text="{Binding ShortText}" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Panel>
    </DockPanel>
</UserControl>
