<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ADA.ViewModels"
        x:Class="ADA.Views.UpdatesWindow"
        x:DataType="vm:UpdatesViewModel"
        Title="Mod Updates"
        Width="640" Height="560" MinWidth="460" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}">
    <LayoutTransformControl LayoutTransform="{DynamicResource InterfaceScaleTransform}">
        <DockPanel>
            <!-- Update all at the bottom. -->
            <Border DockPanel.Dock="Bottom" Padding="24,14" BorderThickness="0,1,0,0"
                    Background="{DynamicResource SurfaceSunkenBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                               Text="{Binding ProgressText}"
                               IsVisible="{Binding ProgressText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                               Text="{Binding GameRunningText}" IsVisible="{Binding IsGameRunning}"
                               Foreground="{DynamicResource WarningBrush}" />
                    <Button Grid.Column="1" Margin="12,0,8,0" Classes="accent" Content="Update all"
                            Command="{Binding UpdateAllCommand}" />
                    <Button Grid.Column="2" Content="Close" Click="OnClose" />
                </Grid>
            </Border>

            <StackPanel DockPanel.Dock="Top" Margin="24,20,24,8" Spacing="6">
                <TextBlock Text="Mod updates" FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <SelectableTextBlock Text="{Binding Notice}" TextWrapping="Wrap"
                                     IsVisible="{Binding Notice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                     Foreground="{DynamicResource WarningBrush}" />
            </StackPanel>

            <ScrollViewer Margin="0,4,0,0">
                <ItemsControl ItemsSource="{Binding Items}" Margin="24,0,24,16">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ModUpdateItemViewModel">
                            <Border Padding="16,12" CornerRadius="8" BorderThickness="1"
                                    Background="{DynamicResource SurfaceRaisedBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding VersionText}" FontSize="12"
                                                       Foreground="{DynamicResource AccentBrush}" />
                                            <TextBlock Text="{Binding GameText}" FontSize="12" IsVisible="{Binding ShowGame}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center"
                                                      Content="Changelog" IsChecked="{Binding ShowChangelog, Mode=OneWay}"
                                                      Command="{Binding ToggleChangelogCommand}" />
                                        <Button Grid.Column="2" VerticalAlignment="Center" Content="Update"
                                                Command="{Binding UpdateCommand}" />
                                    </Grid>
                                    <SelectableTextBlock Text="{Binding Changelog}" TextWrapping="Wrap" FontSize="12"
                                                         IsVisible="{Binding ShowChangelog}"
                                                         Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </LayoutTransformControl>
</Window>
