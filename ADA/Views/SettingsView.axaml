<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ADA.ViewModels"
             x:Class="ADA.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <ScrollViewer>
        <StackPanel Margin="32,28" Spacing="20" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />

            <StackPanel Spacing="8">
                <TextBlock Text="APPEARANCE" FontSize="12" FontWeight="SemiBold" LetterSpacing="1"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <Border Padding="20,16" CornerRadius="8" BorderThickness="1"
                        Background="{DynamicResource SurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}">
                    <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="4" Margin="0,0,24,0">
                                <TextBlock Text="Interface scale" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="Makes text and controls larger or smaller in every ADA window." />
                            </StackPanel>
                            <ComboBox Grid.Column="1" VerticalAlignment="Center" MinWidth="120"
                                      AutomationProperties.Name="Interface scale"
                                      ItemsSource="{Binding InterfaceScales}"
                                      SelectedItem="{Binding InterfaceScale}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="x:Int32">
                                        <TextBlock Text="{Binding StringFormat={}{0}%}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="4" Margin="0,0,24,0">
                                <TextBlock Text="Theme" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="Light or dark colours. System matches your computer's appearance and follows it when it changes." />
                            </StackPanel>
                            <ComboBox Grid.Column="1" VerticalAlignment="Center" MinWidth="120"
                                      AutomationProperties.Name="Theme"
                                      ItemsSource="{Binding Themes}"
                                      SelectedItem="{Binding Theme}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="DOWNLOADS" FontSize="12" FontWeight="SemiBold" LetterSpacing="1"
                           Foreground="{DynamicResource TextSecondaryBrush}" />

                <Border Padding="20,16" CornerRadius="8" BorderThickness="1"
                        Background="{DynamicResource SurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}">
                    <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="4" Margin="0,0,24,0">
                                <TextBlock Text="Keep downloaded archives" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="Keeps each mod's .smod file after it is installed, so repairing, rolling back and switching profiles work offline without downloading again. When off, archives are deleted once their mod is installed." />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                          OnContent="On" OffContent="Off"
                                          IsChecked="{Binding KeepDownloadedArchives}" />
                        </Grid>

                        <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="4" Margin="0,0,24,0">
                                <TextBlock Text="Download retries" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="How many times to try again when a download fails, or arrives with the wrong size or hash. Between 0 and 8." />
                            </StackPanel>
                            <NumericUpDown Grid.Column="1" VerticalAlignment="Center" Width="120"
                                           Minimum="{Binding MinDownloadRetries}" Maximum="{Binding MaxDownloadRetries}"
                                           Increment="1" FormatString="0" ClipValueToMinMax="True"
                                           Value="{Binding DownloadRetries}" />
                        </Grid>

                        <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="4" Margin="0,0,24,0">
                                <TextBlock Text="{Binding ArchiveSummary}"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <SelectableTextBlock Text="{Binding ArchivesFolder}" FontFamily="monospace" FontSize="12"
                                                     TextWrapping="Wrap"
                                                     Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1" VerticalAlignment="Center" Content="Delete archives"
                                    Command="{Binding DeleteArchivesCommand}" />
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="SERVERS" FontSize="12" FontWeight="SemiBold" LetterSpacing="1"
                           Foreground="{DynamicResource TextSecondaryBrush}" />

                <Border Padding="20,16" CornerRadius="8" BorderThickness="1"
                        Background="{DynamicResource SurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="4" Margin="0,0,24,0">
                            <TextBlock Text="Check every uploaded file" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="Reads each file back from the server after uploading it and compares it with the original. Turn off on slow connections to only check sizes; SSH already protects the transfer, and Check (full) can verify everything later." />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                      OnContent="On" OffContent="Off"
                                      IsChecked="{Binding CheckServerUploads}" />
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="BROWSING" FontSize="12" FontWeight="SemiBold" LetterSpacing="1"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <Border Padding="20,16" CornerRadius="8" BorderThickness="1"
                        Background="{DynamicResource SurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}">
                    <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="4" Margin="0,0,24,0">
                                <TextBlock Text="Endless Scroll" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="Show more matching mods as you scroll. Turn off to browse the Mods page using Previous and Next." />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                          OnContent="On" OffContent="Off"
                                          AutomationProperties.Name="Endless Scroll"
                                          IsChecked="{Binding EndlessScroll}" />
                        </Grid>

                        <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="4" Margin="0,0,24,0">
                                <TextBlock Text="Mods per page" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="How many mods to show on each page when Endless Scroll is off. Your choice is kept when Endless Scroll is on." />
                            </StackPanel>
                            <ComboBox Grid.Column="1" VerticalAlignment="Center" MinWidth="120"
                                      AutomationProperties.Name="Mods per page"
                                      IsEnabled="{Binding !EndlessScroll}"
                                      ItemsSource="{Binding ModsPageSizes}"
                                      SelectedItem="{Binding ModsPageSize}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="DASHBOARD" FontSize="12" FontWeight="SemiBold" LetterSpacing="1"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <Border Padding="20,16" CornerRadius="8" BorderThickness="1"
                        Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="4" Margin="0,0,24,0">
                            <TextBlock Text="Latest updated mods" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Recent releases shown on the dashboard. Changes apply as soon as they are saved."
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <NumericUpDown Grid.Column="1" Width="120" VerticalAlignment="Center"
                                       AutomationProperties.Name="Latest updated mods"
                                       Minimum="{Binding MinDashboardLatestModsCount}" Maximum="{Binding MaxDashboardLatestModsCount}"
                                       Increment="1" FormatString="0" ClipValueToMinMax="True" Value="{Binding DashboardLatestModsCount}" />
                    </Grid>
                </Border>
            </StackPanel>

            <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap"
                       IsVisible="{Binding ErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Foreground="{DynamicResource WarningBrush}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
