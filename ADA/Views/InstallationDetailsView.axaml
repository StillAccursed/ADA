<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ADA.ViewModels"
             x:Class="ADA.Views.InstallationDetailsView" x:DataType="vm:GameInstallViewModel">
    <StackPanel Spacing="12">
        <Button Content="Repair" Command="{Binding RepairCommand}" IsVisible="{Binding HasRepairs}" />
        <StackPanel Spacing="10" IsVisible="{Binding HasFoundMods}">
            <TextBlock Text="{Binding FoundTitle}" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="{Binding FoundNames}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                       IsVisible="{Binding HasImportableMods}" />
            <TextBlock Text="{Binding WrongBuildText}" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}"
                       IsVisible="{Binding HasWrongBuilds}" />
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" IsVisible="{Binding HasImportableMods}"
                       Text="ADA never edits Satisfactory Mod Manager's own files. SMM keeps its own record of what it installed, so after ADA adds or updates mods here, SMM's record won't match this game's Mods folder." />
            <StackPanel Spacing="8" IsVisible="{Binding ShowFoundChoice}">
                <TextBlock Text="ADA can look after them from now on. Their files stay where they are." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                <Button HorizontalAlignment="Stretch" Classes="accent" Command="{Binding ImportToCurrentCommand}"><TextBlock Text="{Binding ImportToCurrentText}" TextWrapping="Wrap" /></Button>
                <Button HorizontalAlignment="Stretch" Command="{Binding ChooseNewProfileCommand}"><TextBlock Text="Add to a new profile…" TextWrapping="Wrap" /></Button>
            </StackPanel>
            <StackPanel Spacing="8" IsVisible="{Binding ShowNewProfile}">
                <TextBlock Text="Profile name" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBox Text="{Binding NewProfileName}" MaxLength="100" AutomationProperties.Name="New profile name" />
                <TextBlock Text="{Binding NewProfileProblem}" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}" IsVisible="{Binding NewProfileProblem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <CheckBox IsChecked="{Binding SwitchToNewProfile}"><TextBlock Text="Switch this game to the new profile now" TextWrapping="Wrap" /></CheckBox>
                <TextBlock Text="If you don't switch, the profile is saved for later and the mods stay in the Mods folder as they are." FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                <WrapPanel><Button Content="Create profile" Classes="accent" Command="{Binding CreateNewProfileCommand}" Margin="0,0,8,8" /><Button Content="Back" Command="{Binding BackToFoundChoiceCommand}" Margin="0,0,0,8" /></WrapPanel>
            </StackPanel>
        </StackPanel>
        <StackPanel Spacing="8" IsVisible="{Binding HasFix}">
            <TextBlock Text="Some mods are missing what they need to load" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
            <ItemsControl ItemsSource="{Binding FixLines}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <WrapPanel><Button Content="Fix" Classes="accent" Command="{Binding FixCommand}" Margin="0,0,8,8" /><Button Content="Not now" Command="{Binding DismissFixCommand}" Margin="0,0,0,8" /></WrapPanel>
            <TextBlock Text="Close Satisfactory first." IsVisible="{Binding IsGameRunning}" Foreground="{DynamicResource WarningBrush}" />
        </StackPanel>
        <SelectableTextBlock Text="{Binding FixProblem}" TextWrapping="Wrap" IsVisible="{Binding HasFixProblem}" Foreground="{DynamicResource WarningBrush}" />
        <TextBlock Text="{Binding UpdatesTitle, StringFormat='{}{0}. Use Check for Updates to review them.'}" TextWrapping="Wrap" IsVisible="{Binding HasUpdates}" Foreground="{DynamicResource AccentBrush}" />
    </StackPanel>
</UserControl>
