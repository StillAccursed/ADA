<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ADA.ViewModels"
        x:Class="ADA.Views.ConfirmWindow"
        x:DataType="vm:ConfirmViewModel"
        Title="{Binding Title}"
        Width="460" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}">
    <Window.Styles>
        <Style Selector="Button.danger:not(:disabled) /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DangerActionBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerActionBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Window.Styles>
    <LayoutTransformControl LayoutTransform="{DynamicResource InterfaceScaleTransform}">
        <StackPanel Margin="24,20" Spacing="12">
            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
            <StackPanel Spacing="4" IsVisible="{Binding HasOption}">
                <CheckBox Content="{Binding OptionText}" IsChecked="{Binding OptionChecked}" IsEnabled="{Binding CanChooseOption}" />
                <TextBlock Text="{Binding OptionUnavailableReason}" TextWrapping="Wrap" FontSize="12" Margin="28,0,0,0"
                           IsVisible="{Binding !CanChooseOption}" Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
                <Button Content="{Binding CancelText}" Command="{Binding CancelCommand}" IsCancel="True" />
                <Button Content="{Binding ConfirmText}" Classes="accent" Classes.danger="{Binding IsDanger}" IsDefault="True"
                        Command="{Binding ConfirmCommand}" />
            </StackPanel>
        </StackPanel>
    </LayoutTransformControl>
</Window>
