<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ADA.ViewModels"
        xmlns:imaging="using:Avalonia.Media.Imaging"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="ADA.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="ADA"
        Width="1100" Height="700" MinWidth="760" MinHeight="480"
        Background="{DynamicResource SurfaceBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <imaging:Bitmap x:Key="SidebarBadge">avares://ADA/Assets/ada-badge-light.png</imaging:Bitmap>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <imaging:Bitmap x:Key="SidebarBadge">avares://ADA/Assets/ada-badge-dark.png</imaging:Bitmap>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <LayoutTransformControl LayoutTransform="{DynamicResource InterfaceScaleTransform}">
        <!-- Skyve-style shell: navigation rail | page. The details pane arrives with the Mods page. -->
        <Grid ColumnDefinitions="200,*">
            <Border Grid.Column="0"
                    Background="{DynamicResource SurfaceSunkenBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <Image DockPanel.Dock="Top"
                           Source="{DynamicResource SidebarBadge}"
                           Width="160"
                           Height="56"
                           Margin="20,24,20,20"
                           HorizontalAlignment="Center"
                           Stretch="Uniform"
                           AutomationProperties.Name="ADA" />
                    <!-- The install every page works on; servers join this list once they're set up. -->
                    <ComboBox DockPanel.Dock="Top"
                              Margin="16,0,16,8"
                              HorizontalAlignment="Stretch"
                              PlaceholderText="No game found"
                              AutomationProperties.Name="Installation"
                              ItemsSource="{Binding Dashboard.Installs}"
                              SelectedItem="{Binding Dashboard.SelectedInstall}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:GameInstallViewModel">
                                <StackPanel ToolTip.Tip="{Binding Install.DisplayName}">
                                    <TextBlock Text="{Binding Install.DisplayName}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Install.BuildText}" FontSize="11" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <!-- Footer: check installed mods for updates; the catalogue's last refresh underneath. -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="16,8,16,16" Spacing="6">
                        <Border Height="1" Margin="-8,0,-8,8" Background="{DynamicResource BorderSubtleBrush}" />
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Content="Check for Updates"
                                Click="OnCheckForUpdates" />
                        <TextBlock Text="{Binding Catalog.SummaryText}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding NavItems}"
                             SelectedItem="{Binding SelectedNav}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Background="Transparent"
                             Margin="8,0">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem" x:DataType="vm:NavItem">
                                <Setter Property="IsEnabled" Value="{Binding !IsHeader}" />
                                <Setter Property="Focusable" Value="{Binding !IsHeader}" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:NavItem">
                                <Grid>
                                    <TextBlock Text="{Binding Title}"
                                               IsVisible="{Binding IsHeader}"
                                               Margin="0,12,0,4"
                                               TextAlignment="Center"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <Grid IsVisible="{Binding !IsHeader}"
                                          ColumnDefinitions="16,*,Auto" ColumnSpacing="12">
                                        <TextBlock Text="{Binding Glyph}" TextAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Title}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Grid.Column="2" Text="↑" FontWeight="Bold"
                                                   IsVisible="{Binding HasUpdates}"
                                                   ToolTip.Tip="Mod updates available"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <ContentControl Grid.Column="1" Content="{Binding SelectedNav.Page}" />
        </Grid>
    </LayoutTransformControl>
</Window>
