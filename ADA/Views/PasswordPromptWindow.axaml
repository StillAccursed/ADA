<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ADA.ViewModels"
        x:Class="ADA.Views.PasswordPromptWindow"
        x:DataType="vm:PasswordPromptViewModel"
        Title="{Binding Title}"
        Width="420" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}">
    <LayoutTransformControl LayoutTransform="{DynamicResource InterfaceScaleTransform}">
        <StackPanel Margin="24,20" Spacing="12">
            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBox x:Name="SecretBox" Text="{Binding Secret}" PasswordChar="●" AutomationProperties.Name="{Binding Label}"
                     RevealPassword="{Binding #ShowSecret.IsChecked}">
                <TextBox.InnerRightContent>
                    <ToggleButton x:Name="ShowSecret" Classes="revealSecret" Content="Show" Margin="0,0,4,0"
                                  ToolTip.Tip="Show the password while this is pressed in"
                                  AutomationProperties.Name="Show password" />
                </TextBox.InnerRightContent>
            </TextBox>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
                <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" />
                <Button Content="Connect" Classes="accent" IsDefault="True" Command="{Binding ConnectCommand}" />
            </StackPanel>
        </StackPanel>
    </LayoutTransformControl>
</Window>
